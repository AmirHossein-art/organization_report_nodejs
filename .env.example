# ==========================================
# Organization Report Application - Environment Configuration
# ==========================================

# Server environment ('development' | 'production')
NODE_ENV=production

# Application listening port (Railway provides PORT dynamically)
PORT=3000

# PostgreSQL database connection string
DATABASE_URL="postgresql://user:password@host:5432/database_name?schema=public"

# Secret key used for signing and verifying JWT tokens (Use a strong random string in production)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_chars"

# Optional: Root directory for persistent uploads and WBS storage (Defaults to current working directory)
# For Railway with persistent volume mount, e.g. /data
# STORAGE_ROOT="/data"

# Optional: Comma-separated list of allowed CORS origins (Empty by default for same-origin production deployment)
# ALLOWED_ORIGINS="https://your-domain.railway.app,http://localhost:3000"

# AI Provider Configurations (Primary & Fallbacks)
# Provider 1 (e.g. SambaNova)
AI_BASE_URL_1="https://api.sambanova.ai/v1"
AI_API_KEY_1="your_sambanova_api_key_here"
AI_MODEL_1="Meta-Llama-3.3-70B-Instruct"

# Provider 2 (e.g. Cerebras)
AI_BASE_URL_2="https://api.cerebras.ai/v1"
AI_API_KEY_2="your_cerebras_api_key_here"
AI_MODEL_2="llama-3.3-70b"

# Provider 3 (e.g. Google Gemini via OpenAI-compatible endpoint)
AI_BASE_URL_3="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_API_KEY_3="your_gemini_api_key_here"
AI_MODEL_3="gemini-1.5-flash"
