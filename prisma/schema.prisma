datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// تعریف انواع مقادیر مجاز (Enums)
enum Role {
  user
  manager
}

enum ReportType {
  weekly
  monthly
}

enum ReportStatus {
  submitted
  late
}

enum KpiInputType {
  direct
  percentage_change
}

enum KpiTargetDirection {
  minimum
  maximum
}

// ۱. جدول کاربران
model User {
  id                   Int       @id @default(autoincrement())
  username             String    @unique
  full_name            String
  password             String
  role                 Role      @default(user)
  job_title            String?
  is_active            Boolean   @default(true)
  must_change_password Boolean   @default(true)
  password_changed_at  DateTime?
  created_at           DateTime  @default(now())

  userProjects UserProject[]
  reports      Report[]
  nextActions  NextAction[]
}

// ۲. جدول پروژه‌ها
model Project {
  id                   Int      @id @default(autoincrement())
  title                String
  description          String?
  wbs_file_name        String?
  wbs_storage_filename String?
  code                 String   @unique
  order_index          Int      @default(0)
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())

  userProjects UserProject[]
  reports      Report[]
  kpis         ProjectKpi[]
  nextActions  NextAction[]
}

// ۳. جدول دوره‌های گزارش‌دهی
model ReportPeriod {
  id           Int        @id @default(autoincrement())
  title        String
  report_type  ReportType
  period_start DateTime
  period_end   DateTime
  is_open      Boolean    @default(true)
  created_at   DateTime   @default(now())

  reports Report[]
}

// ۴. جدول رابط کاربری و پروژه‌ها (Many-to-Many)
model UserProject {
  id         Int      @id @default(autoincrement())
  user_id    Int
  project_id Int
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([user_id, project_id]) // جلوگیری از ثبت تکراری یک کاربر در یک پروژه
}

// ۵. جدول فایل‌های ضمیمه گزارش‌ها
model ReportFile {
  id                Int      @id @default(autoincrement())
  report_id         Int
  filename          String
  original_filename String
  file_size         Int
  created_at        DateTime @default(now())

  report Report @relation(fields: [report_id], references: [id], onDelete: Cascade)
}

// ۶. جدول اصلی گزارش‌ها
model Report {
  id               Int          @id @default(autoincrement())
  user_id          Int
  user_full_name   String
  user_username    String
  project_id       Int
  project_title    String
  report_type      ReportType
  period_id        Int
  period_title     String
  period_start     DateTime
  period_end       DateTime
  activities_done  String       @db.Text
  results_achieved String       @default("") @db.Text
  kpi_text         String       @default("") @db.Text
  status           ReportStatus
  submitted_at     DateTime     @default(now())

  source_file_name String?
  source_page      Int?
  import_key       String?   @unique
  is_legacy_import Boolean   @default(false)
  imported_at      DateTime?

  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  period          ReportPeriod     @relation(fields: [period_id], references: [id], onDelete: Cascade)
  files           ReportFile[]
  nextActions     NextAction[]     @relation("ReportNextActions")
  achievedActions NextAction[]     @relation("ReportAchievedActions")
  kpiValues       ReportKpiValue[]

  @@unique([project_id, period_id], name: "one_report_per_project_period")
}

model NextAction {
  id              Int       @id @default(autoincrement())
  report_id       Int?
  project_id      Int?
  user_id         Int?
  created_by_role Role      @default(user)
  action_text     String    @db.Text

  target_date     DateTime?
  target_date_raw String?

  claimed_completed Boolean   @default(false)
  claimed_at        DateTime?
  claimed_report_id Int?

  is_completed      Boolean   @default(false)
  completed_at      DateTime?
  verified_at       DateTime?

  report         Report?  @relation("ReportNextActions", fields: [report_id], references: [id], onDelete: Cascade)
  claimedReport  Report?  @relation("ReportAchievedActions", fields: [claimed_report_id], references: [id], onDelete: SetNull)
  project        Project? @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([user_id])
  @@index([report_id])
  @@index([claimed_report_id])
}

model ProjectKpi {
  id               Int                @id @default(autoincrement())
  project_id       Int
  name             String
  description      String?            @db.Text
  unit             String
  input_type       KpiInputType       @default(direct)
  target_value     Float
  target_direction KpiTargetDirection
  report_type      ReportType?
  is_active        Boolean            @default(true)
  sort_order       Int                @default(0)
  created_at       DateTime           @default(now())

  project Project          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  values  ReportKpiValue[]

  @@index([project_id, is_active])
}

model ReportKpiValue {
  id               Int      @id @default(autoincrement())
  report_id        Int
  project_kpi_id   Int
  current_value    Float?
  baseline_value   Float?
  calculated_value Float?
  not_measured     Boolean  @default(false)
  missing_reason   String?  @db.Text
  created_at       DateTime @default(now())

  report Report     @relation(fields: [report_id], references: [id], onDelete: Cascade)
  kpi    ProjectKpi @relation(fields: [project_kpi_id], references: [id], onDelete: Cascade)

  @@unique([report_id, project_kpi_id])
  @@index([project_kpi_id])
}

// ۷. جدول تنظیمات ددلاین‌ها
model DeadlineSetting {
  id            Int        @id @default(autoincrement())
  report_type   ReportType
  deadline_day  Int
  deadline_time String // ذخیره به صورت فرمت "HH:MM"
}
